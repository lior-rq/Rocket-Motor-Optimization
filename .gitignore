# Working data: datasets, trained models, run results, figures. Regenerate with
# the scripts; none of it is source.
outputs/

# Only written by the desktop build's redirected stdout/stderr (see
# app/desktop.py:_setup_logging), or when DATA_DIR happens to be the repo root.
logs/

# Reports are what *you* generate about *your* motor. The folder is committed so
# the app has somewhere to write on a fresh clone; its contents never are.
reports/*
!reports/.gitkeep


# This folder ships empty and whatever you drop in stays on your machine.
motor/*
!motor/.gitkeep

# openMotor is GPLv3 and is cloned by scripts/setup_env.sh, not redistributed here.
vendor/

# The page's sources live in frontend/; the build lands in app/static and is
# committed, so running from a clone needs no Node.
frontend/node_modules/
frontend/tsconfig.tsbuildinfo

.venv/
.venv-desktop/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# PyInstaller's work and output directories.
build/
dist/
*.spec.bak
